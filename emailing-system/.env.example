# --- Configuration simple (un seul serveur SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-username
SMTP_PASS=your-password
SMTP_FROM=no-reply@example.com
SMTP_MAX_PER_MINUTE=60

# --- OU configuration avancee (plusieurs serveurs, failover automatique) ---
# SMTP_SERVERS='[
#   {"name":"primary","host":"smtp1.example.com","port":587,"secure":false,
#    "auth":{"user":"user1","pass":"pass1"},"maxPerMinute":60},
#   {"name":"backup","host":"smtp2.example.com","port":587,"secure":false,
#    "auth":{"user":"user2","pass":"pass2"},"maxPerMinute":30}
# ]'

# --- Reglages de la queue / worker ---
EMAILING_DB_PATH=./data/queue.sqlite
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=10
MAX_ATTEMPTS=5
BACKOFF_BASE_MS=30000
BACKOFF_MAX_MS=1800000

# --- Serveur HTTP partage (tracking + unsubscribe + dashboard) ---
# Un seul port pour les trois features ci-dessous. Doit etre PUBLIQUEMENT
# accessible en prod (les clients mail chargent le pixel / suivent les liens
# / desinscrivent depuis internet, pas depuis localhost). localhost marche
# seulement pour les tests locaux.
PUBLIC_SERVER_PORT=4000

# --- Tracking d'ouverture / de clics ---
TRACKING_ENABLED=false
TRACKING_BASE_URL=http://localhost:4000

# --- Unsubscribe en un clic (header List-Unsubscribe) ---
UNSUBSCRIBE_ENABLED=false
UNSUBSCRIBE_BASE_URL=http://localhost:4000
UNSUBSCRIBE_MAILTO=unsubscribe@example.com

# --- Dashboard de campagnes (page /dashboard sur le serveur partage) ---
DASHBOARD_ENABLED=false

# --- Webhooks (notifie ton app des evenements en temps reel) ---
# Chaque requete POST est signee via HMAC-SHA256 dans le header
# X-Webhook-Signature (hex) calcule sur le corps brut avec WEBHOOK_SECRET -
# verifie cette signature cote receveur pour t'assurer que la requete vient
# bien d'ici. Evenements emis: email.sent, email.bounced, email.failed,
# email.opened, email.clicked, email.unsubscribed.
WEBHOOKS_ENABLED=false
WEBHOOK_URL=https://ton-app.example.com/webhooks/emailing
WEBHOOK_SECRET=change-moi
