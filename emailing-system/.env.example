# --- Configuration simple (un seul serveur SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-username
SMTP_PASS=your-password
SMTP_FROM=no-reply@example.com
SMTP_MAX_PER_MINUTE=60

# --- OU configuration avancee (plusieurs serveurs, failover automatique) ---
# SMTP_SERVERS='[
#   {"name":"primary","host":"smtp1.example.com","port":587,"secure":false,
#    "auth":{"user":"user1","pass":"pass1"},"maxPerMinute":60},
#   {"name":"backup","host":"smtp2.example.com","port":587,"secure":false,
#    "auth":{"user":"user2","pass":"pass2"},"maxPerMinute":30}
# ]'

# --- Reglages de la queue / worker ---
EMAILING_DB_PATH=./data/queue.sqlite
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=10
MAX_ATTEMPTS=5
BACKOFF_BASE_MS=30000
BACKOFF_MAX_MS=1800000
